APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
HTTP_ADDR=127.0.0.1:8090
DATA_DIR=data

# Database sama dengan app.bizbos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MAX_OPEN=30

# Tiga rahasia berbeda, masing-masing minimal 32 karakter. Isi yang sama di .env app.bizbos.
# Buat dengan: php -r "echo bin2hex(random_bytes(32));"
WA_API_SECRET=
WA_ACCESS_SECRET=
WA_WEBHOOK_SECRET=
WA_WEBHOOK_URL=http://127.0.0.1:8000/api/webhooks/wa

# Origin halaman bizbos yang boleh membuka SSE (pisahkan dengan koma)
ALLOWED_ORIGINS=http://127.0.0.1:8000

# Blast (anti-ban)
BLAST_MIN_DELAY=8
BLAST_MAX_DELAY=20
BLAST_DAILY_CAP=200
QUIET_START_HOUR=21
QUIET_END_HOUR=7
MAX_PARALLEL_SENDS=20
